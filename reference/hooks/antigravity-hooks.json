{
  "context-bundle-sync": {
    "enabled": true,
    "PostToolUse": [
      {
        "matcher": "write_to_file",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .context/scripts/sync_bundle.py",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .context/scripts/sync_bundle.py",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
