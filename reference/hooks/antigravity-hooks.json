{
  "context-bundle-sync": {
    "enabled": true,
    "PostToolUse": [
      {
        "matcher": "write_to_file|replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "(python3 .context/scripts/sync_bundle.py 2>/dev/null || python3 ../.context/scripts/sync_bundle.py) >&2 && echo '{}'",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
